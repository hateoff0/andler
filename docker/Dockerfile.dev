# syntax=docker/dockerfile:1
#
# Multi-stage build для ANDLER.
#
# Таргеты:
#   builder            — компилирует весь workspace, общий слой для остальных
#   unit-test          — `cargo test --workspace`, БЕЗ /dev/kvm.
#                        Гонять на каждый PR (см. §7 CORE_ARCHITECTURE_PLAN.md):
#                          docker build --target unit-test -t andler:unit-test .
#                          docker run --rm andler:unit-test
#   integration-test   — тесты, которым нужен реальный qemu-system-x86_64 и
#                        /dev/kvm (andler-qemu spawn/QMP round-trip). Требует
#                        запуска с --device=/dev/kvm на Linux-хосте с KVM —
#                        собрать образ без него можно, а запустить тесты нет.
#                          docker build --target integration-test -t andler:itest .
#                          docker run --rm --device=/dev/kvm andler:itest
#   daemon             — минимальный runtime-образ andlerd (см. docker-compose.yml)
#   e2e                — реальный andlerd + andler в одном контейнере, гоняет
#                        docker/e2e_smoke.sh: настоящий процесс, настоящий TCP,
#                        настоящий sqlite-файл на диске, настоящий перезапуск
#                        демона. Требует --device=/dev/kvm (как и
#                        integration-test):
#                          docker compose -f docker/docker-compose.yml run --rm e2e
#
# Источник истины по тому, какие тесты куда относятся — README.md каждого
# крейта и docs/architecture/CORE_ARCHITECTURE_PLAN.md, §7.

ARG RUST_VERSION=1

# ---------------------------------------------------------------------------
# builder — компилирует весь workspace один раз, дальше переиспользуется
# ---------------------------------------------------------------------------
FROM rust:${RUST_VERSION}-bookworm AS builder

WORKDIR /andler

# protobuf-compiler — нужен build.rs крейта andler-rpc (tonic-build/prost
# зовут системный `protoc`, сами его не вендорят). Ставим в самом начале
# builder-стадии, а не позже — это системный пакет, а не Cargo-зависимость,
# инвалидация слоя при изменении Cargo.toml/исходников его не трогает.
RUN apt-get update && apt-get install -y --no-install-recommends \
        protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

# Системные зависимости, нужные для сборки (а не только для запуска) —
# на текущем этапе пусто: andler-core/andler-qemu пока не тянут C-библиотек
# напрямую (qemu-img/qemu-system вызываются как внешние процессы, а не
# линкуются). Если появятся bindings (например, к libvirt) — добавлять сюда.

# Кэшируем зависимости отдельным слоем: копируем только манифесты сначала.
# Cargo.lock коммитится в репозиторий (стандартная практика для бинарных
# проектов вроде andlerd/andler-cli — фиксирует точные версии зависимостей
# для воспроизводимой сборки) и копируется явно, как и Cargo.toml.
COPY Cargo.toml Cargo.lock ./
COPY crates/andler-core/Cargo.toml crates/andler-core/Cargo.toml
COPY crates/andler-qemu/Cargo.toml crates/andler-qemu/Cargo.toml
COPY crates/andler-vmm/Cargo.toml crates/andler-vmm/Cargo.toml
COPY crates/andler-disk/Cargo.toml crates/andler-disk/Cargo.toml
COPY crates/andler-net/Cargo.toml crates/andler-net/Cargo.toml
COPY crates/andler-store/Cargo.toml crates/andler-store/Cargo.toml
COPY crates/andler-rpc/Cargo.toml crates/andler-rpc/Cargo.toml
COPY crates/andler-daemon/Cargo.toml crates/andler-daemon/Cargo.toml
COPY crates/andler-cli/Cargo.toml crates/andler-cli/Cargo.toml

# Фиктивные src/main.rs|lib.rs, чтобы `cargo fetch` мог разрезолвить граф
# зависимостей без реального кода — реальный код копируется ниже и
# инвалидирует только компиляцию, а не повторное скачивание crates.io.
RUN for crate in andler-core andler-qemu andler-vmm andler-disk andler-net andler-store andler-rpc; do \
        mkdir -p crates/$crate/src && echo "// placeholder" > crates/$crate/src/lib.rs; \
    done && \
    for crate in andler-daemon andler-cli; do \
        mkdir -p crates/$crate/src && echo "fn main() {}" > crates/$crate/src/main.rs; \
    done

RUN cargo fetch

# Теперь реальный код — этот слой инвалидируется при изменении исходников,
# но не дёргает сеть повторно (зависимости уже в локальном registry-кэше).
COPY crates/ crates/

# --bins обязателен наравне с --tests: cargo build НЕ объединяет дефолтный
# набор целей (lib+bins) с явно указанным --tests — указание любого
# target-selection флага сужает сборку только до целей этого вида. Без
# --bins тут собрались бы только тестовые бинарники, а andlerd/andler
# (нужные стадиям daemon и e2e ниже через COPY --from=builder) не
# появились бы в target/debug — именно так молча и произошло на практике.
RUN cargo build --workspace --bins --tests

# ---------------------------------------------------------------------------
# unit-test — без /dev/kvm, безопасно гонять на любом CI-раннере
# ---------------------------------------------------------------------------
FROM builder AS unit-test

# `--workspace` гоняет тесты всех крейтов, но крейты, требующие /dev/kvm
# для части тестов (andler-qemu, andler-daemon), должны помечать такие
# тесты `#[ignore]` с явной причиной в комментарии — см. README этих
# крейтов. `unit-test` таргет НЕ передаёт --device=/dev/kvm, поэтому
# непомеченный тест, которому реально нужен KVM, здесь упадёт — это
# сигнал, что тест попал не в тот таргет, а не баг Dockerfile.
CMD ["cargo", "test", "--workspace"]

# ---------------------------------------------------------------------------
# integration-test — с реальным QEMU, требует --device=/dev/kvm при запуске
# ---------------------------------------------------------------------------
FROM builder AS integration-test

RUN apt-get update && apt-get install -y --no-install-recommends \
        qemu-system-x86 \
        qemu-utils \
    && rm -rf /var/lib/apt/lists/*

# Тесты, помеченные #[ignore], делятся на два случая: требующие /dev/kvm
# (andler-qemu spawn/QMP) и требующие просто бинарник qemu-img без KVM
# (andler-disk qcow2/overlay — реальное создание файлов). Оба запускаются
# здесь явно через --ignored, так как оба недоступны в unit-test (там нет
# ни /dev/kvm, ни qemu-utils). Конвенция тегирования — см. README
# crates/andler-qemu и crates/andler-disk.
CMD ["cargo", "test", "--workspace", "--", "--ignored"]

# ---------------------------------------------------------------------------
# daemon — минимальный runtime-образ andlerd (не тестовый, для docker-compose)
# ---------------------------------------------------------------------------
FROM debian:bookworm-slim AS daemon

RUN apt-get update && apt-get install -y --no-install-recommends \
        qemu-system-x86 \
        qemu-utils \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /andler/target/debug/andlerd /usr/local/bin/andlerd

ENTRYPOINT ["/usr/local/bin/andlerd"]

# ---------------------------------------------------------------------------
# e2e — andlerd + andler в одном контейнере, реальный сквозной прогон
# ---------------------------------------------------------------------------
# Наследуется прямо от builder (а не от debian:bookworm-slim, как daemon) —
# обоим бинарникам (andlerd и andler) уже физически место на диске после
# `cargo build --workspace --tests` в builder-стадии, COPY --from=builder
# здесь был бы копированием из себя в себя. Нужны только qemu-system-x86/
# qemu-utils (для реального запуска VM и подготовки фикстур qcow2) — все
# остальные системные зависимости уже есть в builder.
FROM builder AS e2e

RUN apt-get update && apt-get install -y --no-install-recommends \
        qemu-system-x86 \
        qemu-utils \
        ovmf \
        procps \
    && rm -rf /var/lib/apt/lists/*

# `qemu-system-gui` (SDL/GTK-фронтенды — тянет за собой X11/Wayland/GTK,
# ~140 пакетов, см. историю слоя) здесь не нужен: фикстура e2e использует
# `display_engine = "None"` (настоящий headless `-display none`), без
# какого-либо локального дисплейного сервера. Если это когда-нибудь
# снова понадобится (например, отдельный e2e на SDL-путь) — возвращать
# сюда явно, не предполагая, что "осталось с прошлого раза" значит
# "нужно сейчас".
#
# Раньше здесь рассматривалось также скачивание настоящего загружаемого
# ISO (Alpine) вместо пустого `empty.iso` — отложено: без `-serial
# mon:stdio` (которого `andler-qemu::cmdline` сейчас не выставляет ни для
# одного инстанса) вывод гостевого ядра уходит на VGA-консоль, не в
# stdout/stderr процесса QEMU, так что реальный ISO сам по себе не решил
# бы задачу детерминированного вывода для `andler logs` — а добавление
# `-serial` для всех инстансов — отдельное продуктовое решение (куда
# девать вывод гостя, не конфликтует ли с QMP на том же stdio), не
# деталь fixture для одного smoke-теста. См. e2e_smoke.sh за тем, как
# `andler logs` проверяется сейчас (через гарантированную SIGTERM-строку
# при остановке, не через естественный вывод во время работы).

# `andler-core::FirmwareConfig::reference_default` (используемый
# `andler-cli`'s `InstanceFile` без возможности переопределения из TOML —
# поля `ovmf_code_path` там просто нет) хардкодит Arch-стиль путь
# `/usr/share/edk2-ovmf/x64/OVMF_CODE.4m.fd`. Debian-пакет `ovmf` кладёт
# реальный файл в `/usr/share/OVMF/` под одним из нескольких возможных
# имён (зависит от версии пакета: 4M-вариант появился позже обычного) —
# подставляем под ожидаемым путём первый найденный кандидат. Без этого,
# qemu-system-x86_64 падает мгновенно на первом pflash-drive, и
# `andler start` (который только спавнит процесс, не ждёт его) рапортует
# успех, в то время как реальный процесс уже мёртв к моменту следующего
# `status`.
RUN mkdir -p /usr/share/edk2-ovmf/x64 && \
    CODE_SRC="$(ls /usr/share/OVMF/OVMF_CODE_4M.fd /usr/share/OVMF/OVMF_CODE.fd 2>/dev/null | head -n1)" && \
    test -n "$CODE_SRC" && \
    cp "$CODE_SRC" /usr/share/edk2-ovmf/x64/OVMF_CODE.4m.fd

RUN ln -sf /andler/target/debug/andlerd /usr/local/bin/andlerd && \
    ln -sf /andler/target/debug/andler /usr/local/bin/andler

COPY docker/e2e_smoke.sh /usr/local/bin/e2e_smoke.sh
RUN chmod +x /usr/local/bin/e2e_smoke.sh

CMD ["/usr/local/bin/e2e_smoke.sh"]
