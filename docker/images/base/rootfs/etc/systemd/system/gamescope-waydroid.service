[Unit]
Description=Gamescope + Waydroid full UI session
Documentation=https://github.com/ValveSoftware/gamescope https://waydro.id
After=android.target waydroid-container.service systemd-udev-settle.service
Requires=waydroid-container.service
PartOf=android.target

[Service]
Type=simple
EnvironmentFile=-/etc/andler/display.conf
Environment=ANDLER_DISPLAY_WIDTH=1280
Environment=ANDLER_DISPLAY_HEIGHT=720
ExecStart=/usr/bin/gamescope \
    -W ${ANDLER_DISPLAY_WIDTH} -H ${ANDLER_DISPLAY_HEIGHT} \
    --backend drm \
    --fullscreen \
    --immediate-flips \
    -- /usr/bin/waydroid show-full-ui
Restart=on-failure
RestartSec=2
# Explicit User/Groups needed: no systemd-logind, must set DRM/input access manually
User=user
Group=user
SupplementaryGroups=video render input seat
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=android.target
