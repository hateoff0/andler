[Unit]
Description=ANDLER PipeWire PulseAudio compatibility (provides the socket waydroid's LXC container mounts)
PartOf=android.target
After=andler-pipewire.service systemd-user-sessions.service
Requires=andler-pipewire.service
Before=waydroid-compositor.service

[Service]
Type=simple
User=user
PAMName=login
ExecStart=/usr/bin/pipewire-pulse
Restart=on-failure
RestartSec=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=android.target
