# syntax=docker/dockerfile:1

ARG RUST_VERSION=1

# --- builder ---
FROM rust:${RUST_VERSION}-bookworm AS builder

WORKDIR /andler

RUN apt-get update && apt-get install -y --no-install-recommends \
        protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY core/andler-core/Cargo.toml core/andler-core/Cargo.toml
COPY backends/andler-qemu/Cargo.toml backends/andler-qemu/Cargo.toml
COPY backends/andler-vmm/Cargo.toml backends/andler-vmm/Cargo.toml
COPY services/andler-disk/Cargo.toml services/andler-disk/Cargo.toml
COPY services/andler-net/Cargo.toml services/andler-net/Cargo.toml
COPY services/andler-firmware/Cargo.toml services/andler-firmware/Cargo.toml
COPY services/andler-store/Cargo.toml services/andler-store/Cargo.toml
COPY services/andler-rpc/Cargo.toml services/andler-rpc/Cargo.toml
COPY daemon/Cargo.toml daemon/Cargo.toml
COPY cli/Cargo.toml cli/Cargo.toml

# Stub files for cargo fetch dependency resolution
RUN for crate in andler-core andler-qemu andler-vmm andler-disk andler-net andler-firmware andler-store andler-rpc; do \
        dir="core/$crate"; [ -d "backends/$crate" ] && dir="backends/$crate"; [ -d "services/$crate" ] && dir="services/$crate"; \
        mkdir -p "$dir/src" && echo "// placeholder" > "$dir/src/lib.rs"; \
    done && \
    mkdir -p daemon/src && echo "fn main() {}" > daemon/src/main.rs && \
    mkdir -p cli/src && echo "fn main() {}" > cli/src/main.rs

RUN cargo fetch

# Real source (invalidates build layer only, not fetch)
COPY core/ core/
COPY backends/ backends/
COPY services/ services/
COPY daemon/ daemon/
COPY cli/ cli/

# --bins required alongside --tests (cargo build narrows to specified target kind)
RUN cargo build --workspace --bins --tests

# --- unit-test ---
FROM builder AS unit-test

CMD ["cargo", "test", "--workspace"]

# --- integration-test ---
FROM builder AS integration-test

RUN apt-get update && apt-get install -y --no-install-recommends \
        qemu-system-x86 \
        qemu-utils \
    && rm -rf /var/lib/apt/lists/*

CMD ["cargo", "test", "--workspace", "--", "--ignored"]

# --- daemon ---
FROM debian:bookworm-slim AS daemon

RUN apt-get update && apt-get install -y --no-install-recommends \
        qemu-system-x86 \
        qemu-utils \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /andler/target/debug/andlerd /usr/local/bin/andlerd

ENTRYPOINT ["/usr/local/bin/andlerd"]

# --- e2e ---
FROM builder AS e2e

RUN apt-get update && apt-get install -y --no-install-recommends \
        qemu-system-x86 \
        qemu-utils \
        ovmf \
        procps \
    && rm -rf /var/lib/apt/lists/*

# Map Arch-style OVMF path to Debian package location
RUN mkdir -p /usr/share/edk2-ovmf/x64 && \
    CODE_SRC="$(ls /usr/share/OVMF/OVMF_CODE_4M.fd /usr/share/OVMF/OVMF_CODE.fd 2>/dev/null | head -n1)" && \
    test -n "$CODE_SRC" && \
    cp "$CODE_SRC" /usr/share/edk2-ovmf/x64/OVMF_CODE.4m.fd

RUN ln -sf /andler/target/debug/andlerd /usr/local/bin/andlerd && \
    ln -sf /andler/target/debug/andler /usr/local/bin/andler

COPY docker/dev/e2e_smoke.sh /usr/local/bin/e2e_smoke.sh
RUN chmod +x /usr/local/bin/e2e_smoke.sh

CMD ["/usr/local/bin/e2e_smoke.sh"]
